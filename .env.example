# Local development template: copy to .env.local. All credential fields are intentionally blank.
# Use YOUR disposable development project; never request the maintainers' credentials.
# OPENAI_API_KEY is server-only. Never add NEXT_PUBLIC_ to any secret.
OPENAI_API_KEY=
# A model with Responses API + structured-output support, available to your project.
OPENAI_MODEL=
# Optional, model-dependent. Set only an effort supported by your chosen model.
OPENAI_REASONING_EFFORT=

# Legacy unit-test adapter setting; live Milestone 4 always requires verified Supabase access.
COACH_ALLOW_ANONYMOUS=false
COACH_PROVIDER_TIMEOUT_MS=15000
COACH_REQUEST_TIMEOUT_MS=45000
COACH_MAX_OUTPUT_TOKENS=1800
COACH_POLICY_OUTPUT_TOKENS=1000
COACH_REQUESTS_PER_MINUTE=8
COACH_GLOBAL_REQUESTS_PER_MINUTE=30
COACH_MAX_CONCURRENT=2
COACH_DAILY_TOKEN_LIMIT=100000

# Optional current per-million USD prices for YOUR configured model.
# Blank means cost unknown; no fabricated price is used.
OPENAI_INPUT_PRICE_PER_MILLION=
OPENAI_OUTPUT_PRICE_PER_MILLION=
# Aggregate token/cost events only; no prompts, messages, profiles, or credentials.
COACH_LOG_USAGE=false

# Account features require YOUR Supabase project and all repository migrations.
# Local CLI: supabase start, then supabase status; use the local URL and anon/service_role
# keys (legacy local key names map to publishable/secret variables below).
# Hosted development: get the URL/publishable key and server secret from YOUR project.
# Secret key is server-only, used for shared AI controls, validated chat writes and account deletion.
# Live paid Coach always requires a verified user; COACH_ALLOW_ANONYMOUS no longer grants access.
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
USDA_FDC_API_KEY=
NUTRITION_ALLOW_FIXTURES=true
COACH_GLOBAL_DAILY_TOKEN_LIMIT=1000000
# Configure current model prices above BEFORE enabling money-denominated caps.
COACH_DAILY_COST_USD=
COACH_GLOBAL_DAILY_COST_USD=

# Optional conservative programme guards; availability and experience still apply.
PLAN_MIN_SESSION_SETS=6
PLAN_MAX_SESSION_SETS=24
PLAN_MAX_WEEKLY_MUSCLE_SETS=24
PLAN_PATTERN_EXPOSURES=2
